# Contraseña del administrador de SQL Server (sa).
# SQL Server exige mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Cambia_Esta_Clave1!
# Contraseña del usuario de la aplicación (app_mant). No uses comillas.
DB_PASSWORD=Clave_App_Mant1!
# Secreto para firmar los JWT (Fase 3). Genéralo con: openssl rand -base64 32
JWT_SECRET=pega_aqui_el_resultado_de_openssl
JWT_EXPIRATION_MS=3600000